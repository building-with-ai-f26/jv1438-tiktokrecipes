# Copy this file to .env and fill in your keys:
#   cp .env.example .env
# NEVER commit your actual .env file to Git!

OPENROUTER_API_KEY=sk-or-v1-replace-with-your-key

# Which OpenRouter model to use. Claude Haiku 5.5 is paid (needs OpenRouter credits) but costs
# well under $0.01 per request and gives better, more consistent recipes and grocery lists.
# Use openrouter/free for $0 (slower, quality varies because it picks a random free model).
OPENROUTER_MODEL=anthropic/claude-haiku-5.5
