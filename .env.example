# Copy this file to .env and fill in your keys:
#   cp .env.example .env
# NEVER commit your actual .env file to Git!

OPENROUTER_API_KEY=sk-or-v1-replace-with-your-key

# Which OpenRouter model to use (paid, needs OpenRouter credits; set a spend cap on your key).
# DeepSeek V4 Flash is the cheapest good option, about $0.0003 per request.
# Use openrouter/free for $0 (slower, quality varies because it picks a random free model).
OPENROUTER_MODEL=deepseek/deepseek-v4-flash

# Model for recipe screenshots (must read images). openrouter/free picks a free one ($0).
OPENROUTER_VISION_MODEL=openrouter/free

# Sign-in (Supabase). Find both in Supabase: Project Settings -> API Keys / Data API.
# The publishable key (sb_publishable_...) is safe in the browser because Row Level Security limits it.
# NEVER put the secret key (sb_secret_...) or service_role key here or anywhere in this app.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace-with-your-key
