# Copy this file to .env and fill in your keys:
#   cp .env.example .env
# NEVER commit your actual .env file to Git!

OPENROUTER_API_KEY=sk-or-v1-replace-with-your-key

# Which OpenRouter model to use. openrouter/free picks any available free model ($0).
# If left out, the app uses anthropic/claude-haiku-4.5 (paid, needs credits).
OPENROUTER_MODEL=openrouter/free
